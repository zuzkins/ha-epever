{
  "services": {
    "force_mppt_reacquire": {
      "name": "Force MPPT reacquire",
      "description": "Experimental: briefly halts PV production (by temporarily lowering the power-component temperature limit) to provoke a fresh MPPT sweep. Rate-limited to once per minute.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Epever controller to toggle. May be omitted when only one is set up."
        },
        "off_seconds": {
          "name": "Off time",
          "description": "How long production stays halted before the limit is restored."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "load_output": {
        "name": "Load Output"
      }
    },
    "sensor": {
      "battery_voltage_status": {
        "name": "Battery voltage status",
        "state": {
          "normal": "Normal",
          "over_voltage": "Over voltage",
          "under_voltage": "Under voltage",
          "low_voltage_disconnect": "Low voltage disconnect",
          "fault": "Fault",
          "unknown": "Unknown"
        }
      },
      "charging_status": {
        "name": "Charging status",
        "state": {
          "no_charging": "Not charging",
          "float": "Float",
          "boost": "Boost",
          "equalize": "Equalize",
          "unknown": "Unknown"
        }
      }
    }
  },
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "user": {
        "data": {
          "device_name": "Device name",
          "device_address": "Device address",
          "device_port": "Device port"
        },
        "description": "Configure your Epever device connection",
        "title": "Epever"
      }
    }
  }
}
